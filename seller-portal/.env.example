# Public Firebase client configuration; values are embedded at build time.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side proxy destination. Keep the public storefront API as the source of truth.
SELLER_API_ORIGIN=https://vooye.in
