# Supabase PostgreSQL. Use the pooler URL for runtime and direct/session URL for migrations.
# Supabase Dashboard → Project Settings → Database → Connection string.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Firebase client configuration — public browser values, safe to expose
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Server Firebase Admin: prefer Application Default Credentials / Workload Identity.
# In local development, set GOOGLE_APPLICATION_CREDENTIALS to an ignored JSON file path.
FIREBASE_ADMIN_PROJECT_ID=""

# Comma-separated Firebase UID values permitted to use admin routes.
ADMIN_UIDS=""

# Razorpay: leave empty to disable online payments. Use test keys before live.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Store settings
NEXT_PUBLIC_STORE_NAME="Vooye"
NEXT_PUBLIC_STORE_URL="http://localhost:3000"
# Shipping is manual during the pilot; use a confirmed rate for the packed parcel.
# Mirror courier prices depend on pickup/delivery PIN, volumetric weight and carrier.
# Do not guess this amount. Checkout returns 503 until a reviewed fee is set.
SHIPPING_PROVIDER="manual"
SHIPPING_FLAT_FEE_PAISE=""
PICKUP_POSTAL_CODE=""
