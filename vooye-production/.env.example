# Supabase Auth and server-side Data API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"
# Server-only secret. Never prefix this with NEXT_PUBLIC_ or pass it to a browser.
SUPABASE_SERVICE_ROLE_KEY=""

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Firebase client configuration (public values)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Comma-separated Firebase Authentication UIDs allowed to administer the store (optional; trusted Prisma User.role=ADMIN is also accepted).
ADMIN_UIDS=""

CHECKOUT_ENABLED="false" # Keep false until all go-live checks are complete.
INVENTORY_EXPIRY_JOB_ENABLED="false" # Set true only after Cloud Scheduler invokes the protected expiry endpoint.
PAYMENT_RECONCILIATION_ENABLED="false" # Set true only after a staffed payment/late-capture/refund process is operational.

# Razorpay ONLY — no COD setting exists
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Invoice records and PDF downloads (server-only runtime variables)
# Required before a PDF invoice can be issued.
INVOICE_SELLER_LEGAL_NAME=""
INVOICE_SELLER_ADDRESS=""
INVOICE_SELLER_EMAIL=""
INVOICE_SELLER_PHONE=""
INVOICE_SELLER_GSTIN=""
INVOICE_NUMBER_PREFIX="VOO-INV"
# Optional automatic invoice email via Resend. Verify this sender/domain in Resend first.
RESEND_API_KEY=""
INVOICE_FROM_EMAIL=""

# Store
NEXT_PUBLIC_STORE_NAME="Vooye"
NEXT_PUBLIC_STORE_URL="http://localhost:3000"
SHIPPING_FLAT_FEE_PAISE="9900"
SERVICEABLE_PIN_CODES="" # Comma-separated exact Indian PIN codes served by your shipping partner
CRON_SECRET="" # Secret bearer token for the pending-order expiry Cloud Scheduler job

# GCP deploy workflow (GitHub Actions variables, not runtime .env)
GCP_PROJECT_ID="vooye-510916"
GCP_REGION="asia-south1"
AR_REPOSITORY="vooye-app"
CLOUD_RUN_SERVICE="vooye-frontend"
WIF_PROVIDER="projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/POOL/providers/PROVIDER"
WIF_SERVICE_ACCOUNT="DEPLOYER_SA@PROJECT_ID.iam.gserviceaccount.com"
