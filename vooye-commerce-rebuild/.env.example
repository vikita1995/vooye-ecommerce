# PostgreSQL (Supabase hosted Postgres or your managed PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vooye?schema=public"

# Firebase client configuration — public browser values, safe to expose
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Server Firebase Admin: prefer Application Default Credentials / Workload Identity.
# In local development, set GOOGLE_APPLICATION_CREDENTIALS to an ignored JSON file path.
FIREBASE_ADMIN_PROJECT_ID=""

# Comma-separated Firebase UID values permitted to use admin routes.
ADMIN_UIDS=""

# Razorpay: leave empty to disable online payments. Use test keys before live.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Store settings
NEXT_PUBLIC_STORE_NAME="Vooye"
NEXT_PUBLIC_STORE_URL="http://localhost:3000"
SHIPPING_FLAT_FEE_PAISE="0"
